{
  "manifest_version": 2,
  "name": "Arabicss KPI Connector",
  "version": "2.5.10",
  "description": "يربط جلسات ومكالمات Arabicss بنظام KPI المستقل",
  "permissions": [
    "storage",
    "notifications",
    "*://41.38.207.218/*",
    "https://marsad-kpi-live.karim87nu.chatgpt.site/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://41.38.207.218/*"
      ],
      "js": [
        "availability.js",
        "content.js",
        "employee-messages.js",
        "break-requests.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "exclude_matches": [
        "*://41.38.207.218/themes/arabicssReportsInclude/*"
      ]
    },
    {
      "matches": [
        "https://marsad-kpi-live.karim87nu.chatgpt.site/admin*"
      ],
      "js": [
        "admin-collector-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    "page-hook.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "arabicss-kpi@eldahan.local",
      "strict_min_version": "142.0",
      "update_url": "https://karim87nu-create.github.io/marsad-kpi/firefox-updates.json",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "authenticationInfo",
          "personalCommunications",
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js",
      "message-notifications.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "موصل إدارة أرابيكس",
    "default_popup": "collector.html"
  }
}
