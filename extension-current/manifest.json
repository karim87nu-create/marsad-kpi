{
  "manifest_version": 2,
  "name": "Arabicss KPI Connector",
  "version": "2.5.7",
  "description": "\u064a\u0631\u0628\u0637 \u062c\u0644\u0633\u0627\u062a \u0648\u0645\u0643\u0627\u0644\u0645\u0627\u062a Arabicss \u0628\u0646\u0638\u0627\u0645 KPI \u0627\u0644\u0645\u0633\u062a\u0642\u0644",
  "permissions": [
    "storage",
    "notifications",
    "*://41.38.207.218/*",
    "https://marsad-kpi-live.karim87nu.chatgpt.site/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://41.38.207.218/*"
      ],
      "js": [
        "availability.js",
        "content.js",
        "employee-messages.js",
        "break-requests.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "exclude_matches": [
        "*://41.38.207.218/themes/arabicssReportsInclude/*"
      ]
    },
    {
      "matches": [
        "https://marsad-kpi-live.karim87nu.chatgpt.site/admin*"
      ],
      "js": [
        "admin-collector-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    "page-hook.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "arabicss-kpi@eldahan.local",
      "strict_min_version": "142.0",
      "update_url": "https://karim87nu-create.github.io/marsad-kpi/firefox-updates.json",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "authenticationInfo",
          "personalCommunications",
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js",
      "message-notifications.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "\u0645\u0648\u0635\u0644 \u0625\u062f\u0627\u0631\u0629 \u0623\u0631\u0627\u0628\u064a\u0643\u0633",
    "default_popup": "collector.html"
  }
}